NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# Opcional: crea un administrador al iniciar cuando ambos valores estén definidos.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Reservado para la futura infraestructura de MongoDB de los módulos.
MONGODB_URI=mongodb://localhost:27017/kambista
