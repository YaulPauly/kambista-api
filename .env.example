NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-characters
JWT_EXPIRES_IN=15m
BCRYPT_SALT_ROUNDS=12

# Opcional: crea un administrador al iniciar cuando ambos valores estén definidos.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Proveedor del tipo de cambio USD/PEN.
EXCHANGE_RATE_PROVIDER_URL=https://api.apis.net.pe/v1/tipo-cambio-sunat
EXCHANGE_RATE_PROVIDER_TOKEN=
EXCHANGE_RATE_REFRESH_INTERVAL_MS=30000
EXCHANGE_RATE_CACHE_TTL_MS=60000
EXCHANGE_RATE_REQUEST_TIMEOUT_MS=5000

# Persistencia MongoDB utilizada por Docker y por los adapters de infraestructura.
MONGODB_URI=mongodb://localhost:27017/kambista
